%% AtropineSalineExploration_AG
% Full exploratory analysis around AtropineSalineExploration_MM.m
%
% Goal:
% 1. Test whether OB gamma decreases after atropine.
% 2. Test whether OB delta increases after atropine.
% 3. Test whether HPC and AEG/ACx CBV signals are correlated and decrease after atropine.
% 4. Test whether OB gamma is anticorrelated with CBV on long timescales.
% 5. Test whether this OB gamma - CBV coupling is preserved or reorganized after atropine.
%
% Important assumptions:
% - Injection time is exactly the middle of the fUS session by design.
% - SleepScoring_OBGamma.mat contains BrainPower.Power{1,1}=OB gamma and
%   BrainPower.Power{1,2}=OB delta, as in AtropineSalineExploration_MM.m.
% - RP_data_*slice_B.mat contains cat_tsd and masks.Hippocampus/masks.AEG.
% - fUS power-Doppler signal is treated as a CBV-like signal. This script
%   explicitly computes baseline-normalized CBV and dCBV-like percent changes;
%   it does not assume that raw ROI averages are already dCBV.
%
% Notes on smoothing:
% - Short smoothing is used only to reduce high-frequency noise in traces.
% - Long smoothing is used only for the explicit long-timescale coupling test.
% - Band-power medians and spectrum means are computed from the original data
%   after minimal smoothing, not from heavily smoothed display traces.
%
% Notes on mean spectra:
% - Spectra are averaged over time within each epoch first, per session.
% - Group spectra are then averaged across sessions.
% - The script stores both raw mean spectra and f*power spectra because older
%   OB scripts often display f*power. Log2(after/before) spectra are computed
%   per session before group averaging; this avoids normalizing only at the
%   group level.
%
% MATLAB: written to stay compatible with R2018b and current custom tsd code.

clear all
close all

%% Parameters

Animal = 'Ficello';
wantedSlice = 'B';

SaveFigures = 1;
SaveFolder = 'Z:\Arsenii\OB_fUS_Arousal\Processed_data\Ficello\Figures_AG\';
if SaveFigures && ~exist(SaveFolder, 'dir')
    mkdir(SaveFolder);
end

% Drug order used throughout this script.
DrugNames = {'Saline','Atropine'};
DrugQueryNames = {'saline','atropine'};
DrugColors = {[.3 .3 .3],[.3 1 .3]};
ColorBefore = [0.3010, 0.7450, 0.9330];
ColorAfter = [0.9290, 0.6940, 0.1250];

% Injection exclusion window. The immediate peri-injection period is excluded
% from pre/post metrics to avoid handling, injection and transient artifacts.
InjExclusionSec = 5*60;

% Smoothing windows. They are defined in seconds and converted into samples
% for each signal using the corresponding time vector.
PowerSmoothSec = 0.3;       % same logic as original script, but not hard-coded to 1250 Hz
TraceSmoothSec = 10;        % for fUS-aligned traces and display-level band-power traces
LongSmoothSec = 5*60;       % explicit long-timescale coupling analysis
SpecImageSmoothBins = 5;    % only for spectrogram display, not for spectrum metrics
DistributionSmoothBins = 5;

% Interpolation grid for pre/post time-course summary. x-axis is normalized
% to the available epoch duration; labels are shown in hours for readability.
NInterp = 100;

% Bands. Please adjust these if you want to use a different OB convention.
% I include gamma sub-bands because the current data may show differential
% effects rather than a uniform suppression of all gamma.
Bands.delta = [0.5 4];
Bands.theta = [3 6];
Bands.lowGamma = [20 40];
Bands.gamma = [40 60];
Bands.highGamma = [50 80];
Bands.gammaPeakSearch = [25 70];
UseFrequencyWeightForSpectrum = 1; % current OB scripts often plot f.*power
UseFrequencyWeightForBandMetrics = 0;    % band metrics are computed from raw spectral power, not f.*power
UseMedianSpectrumForRatio = 1;           % log2(after/before) spectra use per-session median spectra for robustness

% Coupling lags. Positive lag means CBV is evaluated later than OB power:
% corr(OB_gamma(t), CBV(t+lag)).
LagSec = (-30:2:30)*60;

% Optional single-session figures. These are useful QC but can create many files.
MakeSingleSessionFigures = 1;

%% Load sessions
sessions_A = {'Z:\Arsenii\OB_fUS_Arousal\Processed_data\Ficello\20260327',...%A
            'Z:\Arsenii\OB_fUS_Arousal\Processed_data\Ficello\20260401',...%A
            'Z:\Arsenii\OB_fUS_Arousal\Processed_data\Ficello\20260403',...%A
            'Z:\Arsenii\OB_fUS_Arousal\Processed_data\Ficello\20260410',...%A
            'Z:\Arsenii\OB_fUS_Arousal\Processed_data\Ficello\20260417',...%A
    };

sessions_S = {'Z:\Arsenii\OB_fUS_Arousal\Processed_data\Ficello\20260402',...%S
            'Z:\Arsenii\OB_fUS_Arousal\Processed_data\Ficello\20260408',...%S
            'Z:\Arsenii\OB_fUS_Arousal\Processed_data\Ficello\20260409',...%S
            'Z:\Arsenii\OB_fUS_Arousal\Processed_data\Ficello\20260414',...%S
            'Z:\Arsenii\OB_fUS_Arousal\Processed_data\Ficello\20260416',...%S
    };

AllSessions = struct();
sessionCounter = 0;
sessions = {sessions_S';sessions_A'};

for drug = 1:2
%     Dir = PathForExperimentsArousal(Animal, DrugQueryNames{drug}, 'all');
%     paths = Dir.path';
    paths = sessions{drug};
    for i = 1:length(paths)
        sessionCounter = sessionCounter + 1;
        datapath = paths{i};
        [~, sessionName] = fileparts(datapath);
        
        AllSessions(sessionCounter).name = sessionName;
        AllSessions(sessionCounter).path = datapath;
        AllSessions(sessionCounter).drug_id = drug;
        AllSessions(sessionCounter).drug_name = DrugNames{drug};
        AllSessions(sessionCounter).drug_sess = i;
        
        % fUS data
        fus_file = dir(fullfile(datapath, 'fUS', ['RP_data_*slice_' wantedSlice '.mat']));
        if ~isempty(fus_file)
            tmp = load(fullfile(datapath, 'fUS', fus_file(1).name), 'cat_tsd', 'masks');
            AllSessions(sessionCounter).fUS.cat_tsd = tmp.cat_tsd;
            AllSessions(sessionCounter).fUS.masks = tmp.masks;
        else
            warning('No fUS file found for session %s', sessionName)
        end
        
        % OB gamma and delta powers
        GammaPowerFile = fullfile(datapath, 'ephys', 'SleepScoring_OBGamma.mat');
        if exist(GammaPowerFile, 'file')
            tmp = load(GammaPowerFile);
            if isfield(tmp, 'BrainPower')
                AllSessions(sessionCounter).GammaPower = tmp.BrainPower.Power{1,1};
                AllSessions(sessionCounter).DeltaPower = tmp.BrainPower.Power{1,2};
            else
                warning('SleepScoring_OBGamma exists but BrainPower is missing: %s', sessionName)
            end
        else
            warning('No SleepScoring_OBGamma.mat for session %s', sessionName)
        end
        
        % Middle OB spectrum
        specFile = fullfile(datapath, 'ephys', 'B_Middle_Spectrum_HighPass.mat');
        if ~exist(specFile, 'file')
            specFile = fullfile(datapath, 'ephys', 'B_Middle_Spectrum.mat');
        end
        if exist(specFile, 'file')
            tmp = load(specFile); % loads Spectro
            sptsdB = tsd(tmp.Spectro{2}*1e4, tmp.Spectro{1});
            AllSessions(sessionCounter).SpectroMiddle.sptsdB = sptsdB;
            AllSessions(sessionCounter).SpectroMiddle.fB = tmp.Spectro{3};
        else
            warning('No middle spectrum for session %s', sessionName)
        end
        
        % Low OB spectrum
        specFile = fullfile(datapath, 'ephys', 'B_Low_Spectrum.mat');
        if exist(specFile, 'file')
            tmp = load(specFile); % loads Spectro
            sptsdB = tsd(tmp.Spectro{2}*1e4, tmp.Spectro{1});
            AllSessions(sessionCounter).SpectroLow.sptsdB = sptsdB;
            AllSessions(sessionCounter).SpectroLow.fB = tmp.Spectro{3};
        else
            warning('No low spectrum for session %s', sessionName)
        end
        
        % Optional heart rate. Not required for the core hypotheses but useful
        % as a systemic atropine sanity check if HeartBeatInfo exists.
        hbFile = fullfile(datapath, 'ephys', 'HeartBeatInfo.mat');
        if ~exist(hbFile, 'file')
            hbFile = fullfile(datapath, 'HeartBeatInfo.mat');
        end
        if exist(hbFile, 'file')
            tmp = load(hbFile);
            if isfield(tmp, 'EKG') && isfield(tmp.EKG, 'HBRate')
                AllSessions(sessionCounter).HeartRate = tmp.EKG.HBRate;
            end
        end
        
        disp(['Loaded ' DrugNames{drug} ' session: ' sessionName])
    end
end

%% Compute traces, metrics and per-session analysis objects

nSess = length(AllSessions);
Ana = struct();
if nSess > 0
    Metrics = repmat(initialize_metrics(AllSessions(1)), 1, nSess);
else
    Metrics = struct();
end

% Group containers. Cell index 1=saline, 2=atropine.
Group = struct();
for drug = 1:2
    Group.gamma_after_norm{drug} = [];
    Group.delta_after_norm{drug} = [];
    Group.hpc_after_norm{drug} = [];
    Group.aeg_after_norm{drug} = [];
    Group.gamma_before_norm{drug} = [];
    Group.delta_before_norm{drug} = [];
    Group.hpc_before_norm{drug} = [];
    Group.aeg_before_norm{drug} = [];
    Group.middle_log2ratio{drug} = [];
    Group.low_log2ratio{drug} = [];
    Group.middle_before_fweighted{drug} = [];
    Group.middle_after_fweighted{drug} = [];
    Group.low_before_fweighted{drug} = [];
    Group.low_after_fweighted{drug} = [];
    Group.lag_gamma_hpc_before{drug} = [];
    Group.lag_gamma_hpc_after{drug} = [];
    Group.lag_gamma_aeg_before{drug} = [];
    Group.lag_gamma_aeg_after{drug} = [];
    Group.state_occ_before{drug} = [];
    Group.state_occ_after{drug} = [];
end

for sess = 1:nSess
    S = AllSessions(sess);
    drug = S.drug_id;
    j = S.drug_sess;
    Metrics(sess) = initialize_metrics(S);
    
    if ~isfield(S, 'fUS') || ~isfield(S, 'GammaPower') || ~isfield(S, 'DeltaPower')
        warning('Skipping session %s because core data are missing', S.name)
        continue
    end
    
    % fUS ROI traces
    cat_tsd = S.fUS.cat_tsd;
    masks = S.fUS.masks;
    fUSData = Data(cat_tsd.data);
    fUSDataReshaped = reshape(fUSData', cat_tsd.Nx, cat_tsd.Ny, size(fUSData,1));
    Nt = size(fUSDataReshaped,3);
    TFUS = Range(cat_tsd.data,'s');
    TFUS = TFUS(:);
    t_mid = TFUS(round(length(TFUS)/2));
    
    if ~isfield(masks, 'Hippocampus') || ~isfield(masks, 'AEG')
        warning('Skipping session %s because Hippocampus or AEG mask is missing', S.name)
        continue
    end
    
    mask_hipp = masks.Hippocampus;
    mask_AEG = masks.AEG;
    trace_hipp = nan(Nt,1);
    trace_AEG = nan(Nt,1);
    for t = 1:Nt
        frame = fUSDataReshaped(:,:,t);
        trace_hipp(t) = nanmean(frame(mask_hipp));
        trace_AEG(t) = nanmean(frame(mask_AEG));
    end
    clear fUSData fUSDataReshaped
    
    trace_hipp = smooth_by_time(trace_hipp, TFUS, TraceSmoothSec);
    trace_AEG = smooth_by_time(trace_AEG, TFUS, TraceSmoothSec);
    
    [idx_before, idx_after] = injection_epoch_indices(TFUS, t_mid, InjExclusionSec);
    if sum(idx_before) < 10 || sum(idx_after) < 10
        warning('Session %s has too few pre/post fUS points after injection exclusion', S.name)
    end
    
    % Baseline-normalized CBV-like signals (in percent)
%     hpc_baseline = nanmedian(trace_hipp(idx_before));
%     aeg_baseline = nanmedian(trace_AEG(idx_before));
%     hpc_norm = trace_hipp ./ hpc_baseline;
%     aeg_norm = trace_AEG ./ aeg_baseline;
%     hpc_dcbv_percent = 100*(hpc_norm - 1);
%     aeg_dcbv_percent = 100*(aeg_norm - 1);

    % hpc_dcbv / aeg_dcbv are fractional dCBV values:
    %     dCBV = (CBV - baselineCBV) / baselineCBV
    % hpc_norm / aeg_norm are ratio-to-baseline values used for plots:
    %     normCBV = CBV / baselineCBV = 1 + dCBV
    % hpc_dcbv_percent / aeg_dcbv_percent are the same dCBV values in %.
    hpc_baseline = nanmedian(trace_hipp(idx_before));
    aeg_baseline = nanmedian(trace_AEG(idx_before));

    hpc_dcbv = (trace_hipp - hpc_baseline) ./ hpc_baseline;
    aeg_dcbv = (trace_AEG - aeg_baseline) ./ aeg_baseline;

    hpc_norm = 1 + hpc_dcbv;
    aeg_norm = 1 + aeg_dcbv;

    hpc_dcbv_percent = 100*hpc_dcbv;
    aeg_dcbv_percent = 100*aeg_dcbv;

    % Gamma and delta. First apply short smoothing using the real time vector,
    % then align to the fUS time base. Extrapolated values are left as NaN.
    Gamma = S.GammaPower;
    GammaData = Data(Gamma);
    TGamma = Range(Gamma,'s');
    TGamma = TGamma(:);
    GammaData = smooth_by_time(GammaData(:), TGamma, PowerSmoothSec);
    Gamma_interp = interp1(TGamma, GammaData, TFUS, 'linear', NaN);
    Gamma_interp = smooth_by_time(Gamma_interp, TFUS, TraceSmoothSec);
    
    Delta = S.DeltaPower;
    DeltaData = Data(Delta);
    TDelta = Range(Delta,'s');
    TDelta = TDelta(:);
    DeltaData = smooth_by_time(DeltaData(:), TDelta, PowerSmoothSec);
    Delta_interp = interp1(TDelta, DeltaData, TFUS, 'linear', NaN);
    Delta_interp = smooth_by_time(Delta_interp, TFUS, TraceSmoothSec);
    
    gamma_baseline = nanmedian(Gamma_interp(idx_before));
    delta_baseline = nanmedian(Delta_interp(idx_before));
    gamma_norm = Gamma_interp ./ gamma_baseline;
    delta_norm = Delta_interp ./ delta_baseline;
    
    % Long-timescale traces. These are the only traces used for hypotheses
    % about slow OB gamma - CBV coupling. They are log-transformed because
    % the signals are positive and ratios are biologically more meaningful.
    log_gamma_long = smooth_by_time(safe_log(Gamma_interp), TFUS, LongSmoothSec);
    log_delta_long = smooth_by_time(safe_log(Delta_interp), TFUS, LongSmoothSec);
    log_hpc_long = smooth_by_time(safe_log(trace_hipp), TFUS, LongSmoothSec);
    log_aeg_long = smooth_by_time(safe_log(trace_AEG), TFUS, LongSmoothSec);
    
    % State quadrants based on pre-injection medians. This is deliberately
    % simple. It asks whether atropine changes occupancy of OB power states,
    % not whether these are fully validated sleep states.
    log_gamma = safe_log(Gamma_interp);
    log_delta = safe_log(Delta_interp);
    gamma_thr = nanmedian(log_gamma(idx_before));
    delta_thr = nanmedian(log_delta(idx_before));
    OBState = nan(size(TFUS));
    OBState(log_gamma >= gamma_thr & log_delta <  delta_thr) = 1; % high gamma / low delta
    OBState(log_gamma <  gamma_thr & log_delta >= delta_thr) = 2; % low gamma / high delta
    OBState(log_gamma >= gamma_thr & log_delta >= delta_thr) = 3; % high gamma / high delta
    OBState(log_gamma <  gamma_thr & log_delta <  delta_thr) = 4; % low gamma / low delta
    
    occ_before = state_occupancy(OBState, idx_before, 4);
    occ_after = state_occupancy(OBState, idx_after, 4);
    Group.state_occ_before{drug}(j,:) = occ_before;
    Group.state_occ_after{drug}(j,:) = occ_after;
    
    % Store normalized pre/post time courses for group figures.
    Group.gamma_before_norm{drug}(j,:) = interp_epoch_to_unit_time(gamma_norm, idx_before, NInterp);
    Group.gamma_after_norm{drug}(j,:) = interp_epoch_to_unit_time(gamma_norm, idx_after, NInterp);
    Group.delta_before_norm{drug}(j,:) = interp_epoch_to_unit_time(delta_norm, idx_before, NInterp);
    Group.delta_after_norm{drug}(j,:) = interp_epoch_to_unit_time(delta_norm, idx_after, NInterp);
    Group.hpc_before_norm{drug}(j,:) = interp_epoch_to_unit_time(hpc_norm, idx_before, NInterp);
    Group.hpc_after_norm{drug}(j,:) = interp_epoch_to_unit_time(hpc_norm, idx_after, NInterp);
    Group.aeg_before_norm{drug}(j,:) = interp_epoch_to_unit_time(aeg_norm, idx_before, NInterp);
    Group.aeg_after_norm{drug}(j,:) = interp_epoch_to_unit_time(aeg_norm, idx_after, NInterp);
    
    % Core scalar metrics. Each session contributes one value per metric.
    Metrics(sess).session = S.name;
    Metrics(sess).drug = S.drug_name;
    Metrics(sess).drug_id = drug;
    Metrics(sess).drug_sess = j;
    Metrics(sess).inj_time_min = t_mid/60;
    Metrics(sess).n_fus_before = sum(idx_before);
    Metrics(sess).n_fus_after = sum(idx_after);
    
    Metrics(sess).gamma_logratio = log_ratio_median(Gamma_interp, idx_before, idx_after);
    Metrics(sess).delta_logratio = log_ratio_median(Delta_interp, idx_before, idx_after);
    Metrics(sess).hpc_cbv_logratio = log_ratio_median(trace_hipp, idx_before, idx_after);
    Metrics(sess).aeg_cbv_logratio = log_ratio_median(trace_AEG, idx_before, idx_after);
    Metrics(sess).hpc_dcbv_after_percent = nanmedian(hpc_dcbv_percent(idx_after));
    Metrics(sess).aeg_dcbv_after_percent = nanmedian(aeg_dcbv_percent(idx_after));
    
    Metrics(sess).hpc_aeg_r_before = corr_nan(safe_log(trace_hipp(idx_before)), safe_log(trace_AEG(idx_before)));
    Metrics(sess).hpc_aeg_r_after = corr_nan(safe_log(trace_hipp(idx_after)), safe_log(trace_AEG(idx_after)));
    
    Metrics(sess).gamma_hpc_r_before = corr_nan(log_gamma_long(idx_before), log_hpc_long(idx_before));
    Metrics(sess).gamma_hpc_r_after = corr_nan(log_gamma_long(idx_after), log_hpc_long(idx_after));
    Metrics(sess).gamma_aeg_r_before = corr_nan(log_gamma_long(idx_before), log_aeg_long(idx_before));
    Metrics(sess).gamma_aeg_r_after = corr_nan(log_gamma_long(idx_after), log_aeg_long(idx_after));
    Metrics(sess).delta_hpc_r_before = corr_nan(log_delta_long(idx_before), log_hpc_long(idx_before));
    Metrics(sess).delta_hpc_r_after = corr_nan(log_delta_long(idx_after), log_hpc_long(idx_after));
    
    Metrics(sess).gamma_hpc_r_detr_before = corr_nan(detrend_nan(log_gamma_long(idx_before)), detrend_nan(log_hpc_long(idx_before)));
    Metrics(sess).gamma_hpc_r_detr_after = corr_nan(detrend_nan(log_gamma_long(idx_after)), detrend_nan(log_hpc_long(idx_after)));
    Metrics(sess).gamma_aeg_r_detr_before = corr_nan(detrend_nan(log_gamma_long(idx_before)), detrend_nan(log_aeg_long(idx_before)));
    Metrics(sess).gamma_aeg_r_detr_after = corr_nan(detrend_nan(log_gamma_long(idx_after)), detrend_nan(log_aeg_long(idx_after)));
    
    % Lagged coupling curves.
    Group.lag_gamma_hpc_before{drug}(j,:) = lag_corr_curve(TFUS, log_gamma_long, log_hpc_long, idx_before, LagSec);
    Group.lag_gamma_hpc_after{drug}(j,:) = lag_corr_curve(TFUS, log_gamma_long, log_hpc_long, idx_after, LagSec);
    Group.lag_gamma_aeg_before{drug}(j,:) = lag_corr_curve(TFUS, log_gamma_long, log_aeg_long, idx_before, LagSec);
    Group.lag_gamma_aeg_after{drug}(j,:) = lag_corr_curve(TFUS, log_gamma_long, log_aeg_long, idx_after, LagSec);
    
    % Spectral metrics and spectra. These are computed on the spectrum time
    % base, not after interpolation to fUS. Mean spectra are per-session mean
    % spectra over time; group summaries average these session-level spectra.
    if isfield(S, 'SpectroMiddle')
        sptsdB = S.SpectroMiddle.sptsdB;
        spec = Data(sptsdB);
        t_spec = Range(sptsdB,'s');
        t_spec = t_spec(:);
        f = S.SpectroMiddle.fB(:)';
        [idx_spec_before, idx_spec_after] = injection_epoch_indices(t_spec, t_mid, InjExclusionSec);
        
        Spec_before_mean = epoch_spectrum(spec, idx_spec_before, 'mean');
        Spec_after_mean = epoch_spectrum(spec, idx_spec_after, 'mean');
        Spec_before_med = epoch_spectrum(spec, idx_spec_before, 'median');
        Spec_after_med = epoch_spectrum(spec, idx_spec_after, 'median');
        
        if UseFrequencyWeightForSpectrum
            Spec_before_plot = f .* Spec_before_mean;
            Spec_after_plot = f .* Spec_after_mean;
        else
            Spec_before_plot = Spec_before_mean;
            Spec_after_plot = Spec_after_mean;
        end
        
        Group.middle_before_fweighted{drug}(j,:) = Spec_before_plot;
        Group.middle_after_fweighted{drug}(j,:) = Spec_after_plot;

        % Ratio spectra are computed from raw spectra. f.*power is kept only
        % for display. Median spectra make the ratio more robust to bursts.
        if UseMedianSpectrumForRatio
            Spec_before_ratio = Spec_before_med;
            Spec_after_ratio = Spec_after_med;
        else
            Spec_before_ratio = Spec_before_mean;
            Spec_after_ratio = Spec_after_mean;
        end
        Group.middle_log2ratio{drug}(j,:) = log2((Spec_after_ratio + eps) ./ (Spec_before_ratio + eps));

        % Band metrics are intentionally not f-weighted. f.*power is a display
        % convention and would bias broad-band summaries toward higher frequencies.
        gammaSpec = spectrum_band_timeseries(spec, f, Bands.gamma, UseFrequencyWeightForBandMetrics);
        lowGammaSpec = spectrum_band_timeseries(spec, f, Bands.lowGamma, UseFrequencyWeightForBandMetrics);
        highGammaSpec = spectrum_band_timeseries(spec, f, Bands.highGamma, UseFrequencyWeightForBandMetrics);

        Metrics(sess).gamma_spec_logratio = log_ratio_median(gammaSpec, idx_spec_before, idx_spec_after);
        Metrics(sess).lowgamma_spec_logratio = log_ratio_median(lowGammaSpec, idx_spec_before, idx_spec_after);
        Metrics(sess).highgamma_spec_logratio = log_ratio_median(highGammaSpec, idx_spec_before, idx_spec_after);
        Metrics(sess).gamma_peak_before_hz = spectrum_peak_frequency(Spec_before_med, f, Bands.gammaPeakSearch, UseFrequencyWeightForSpectrum);
        Metrics(sess).gamma_peak_after_hz = spectrum_peak_frequency(Spec_after_med, f, Bands.gammaPeakSearch, UseFrequencyWeightForSpectrum);
        Metrics(sess).gamma_peak_shift_hz = Metrics(sess).gamma_peak_after_hz - Metrics(sess).gamma_peak_before_hz;
        
        Ana(sess).middle_f = f;
        Ana(sess).middle_before_plot = Spec_before_plot;
        Ana(sess).middle_after_plot = Spec_after_plot;
        Ana(sess).middle_log2ratio = Group.middle_log2ratio{drug}(j,:);
    else
        Metrics(sess).gamma_spec_logratio = NaN;
        Metrics(sess).lowgamma_spec_logratio = NaN;
        Metrics(sess).highgamma_spec_logratio = NaN;
        Metrics(sess).gamma_peak_before_hz = NaN;
        Metrics(sess).gamma_peak_after_hz = NaN;
        Metrics(sess).gamma_peak_shift_hz = NaN;
    end
    
    if isfield(S, 'SpectroLow')
        sptsdB = S.SpectroLow.sptsdB;
        spec = Data(sptsdB);
        t_spec = Range(sptsdB,'s');
        t_spec = t_spec(:);
        f = S.SpectroLow.fB(:)';
        [idx_spec_before, idx_spec_after] = injection_epoch_indices(t_spec, t_mid, InjExclusionSec);
        
        Spec_before_mean = epoch_spectrum(spec, idx_spec_before, 'mean');
        Spec_after_mean = epoch_spectrum(spec, idx_spec_after, 'mean');
        Spec_before_med = epoch_spectrum(spec, idx_spec_before, 'median');
        Spec_after_med = epoch_spectrum(spec, idx_spec_after, 'median');
        
        if UseFrequencyWeightForSpectrum
            Spec_before_plot = f .* Spec_before_mean;
            Spec_after_plot = f .* Spec_after_mean;
        else
            Spec_before_plot = Spec_before_mean;
            Spec_after_plot = Spec_after_mean;
        end
        
        Group.low_before_fweighted{drug}(j,:) = Spec_before_plot;
        Group.low_after_fweighted{drug}(j,:) = Spec_after_plot;
        if UseMedianSpectrumForRatio
            Spec_before_ratio = Spec_before_med;
            Spec_after_ratio = Spec_after_med;
        else
            Spec_before_ratio = Spec_before_mean;
            Spec_after_ratio = Spec_after_mean;
        end
        Group.low_log2ratio{drug}(j,:) = log2((Spec_after_ratio + eps) ./ (Spec_before_ratio + eps));

        deltaSpec = spectrum_band_timeseries(spec, f, Bands.delta, UseFrequencyWeightForBandMetrics);
        thetaSpec = spectrum_band_timeseries(spec, f, Bands.theta, UseFrequencyWeightForBandMetrics);
        Metrics(sess).delta_spec_logratio = log_ratio_median(deltaSpec, idx_spec_before, idx_spec_after);
        Metrics(sess).theta_spec_logratio = log_ratio_median(thetaSpec, idx_spec_before, idx_spec_after);
        
        Ana(sess).low_f = f;
        Ana(sess).low_before_plot = Spec_before_plot;
        Ana(sess).low_after_plot = Spec_after_plot;
        Ana(sess).low_log2ratio = Group.low_log2ratio{drug}(j,:);
    else
        Metrics(sess).delta_spec_logratio = NaN;
        Metrics(sess).theta_spec_logratio = NaN;
    end
    
    % Store per-session analysis traces for single-session figures.
    Ana(sess).name = S.name;
    Ana(sess).drug_name = S.drug_name;
    Ana(sess).drug_id = drug;
    Ana(sess).TFUS = TFUS;
    Ana(sess).t_mid = t_mid;
    Ana(sess).idx_before = idx_before;
    Ana(sess).idx_after = idx_after;
    Ana(sess).gamma = Gamma_interp;
    Ana(sess).delta = Delta_interp;
    Ana(sess).gamma_norm = gamma_norm;
    Ana(sess).delta_norm = delta_norm;
    Ana(sess).hpc = trace_hipp;
    Ana(sess).aeg = trace_AEG;
    Ana(sess).hpc_norm = hpc_norm;
    Ana(sess).aeg_norm = aeg_norm;
    Ana(sess).hpc_dcbv_percent = hpc_dcbv_percent;
    Ana(sess).aeg_dcbv_percent = aeg_dcbv_percent;
    Ana(sess).log_gamma_long = log_gamma_long;
    Ana(sess).log_hpc_long = log_hpc_long;
    Ana(sess).log_aeg_long = log_aeg_long;
    Ana(sess).OBState = OBState;
    Ana(sess).meanImg = create_mean_fus_image(S.fUS.cat_tsd, S.fUS.masks);
    Ana(sess).masks = masks;
    
    % Optional single-session figure.
    if MakeSingleSessionFigures
        make_single_session_figure(Ana(sess), S, Metrics(sess), ColorBefore, ColorAfter, Bands, SaveFigures, SaveFolder)
    end
    
    disp(['Analyzed ' S.drug_name ' session: ' S.name])
end

